# Copy to .env and fill in your own key. .env is git-ignored; never commit a real key.

# --- model provider: groq or openrouter (any OpenAI-compatible endpoint works via LLM_BASE_URL)
LLM_PROVIDER=groq
LLM_API_KEY=your_key_here
# Groq:       llama-3.1-8b-instant
# OpenRouter: meta-llama/llama-3.1-8b-instruct
MODEL_NAME=llama-3.1-8b-instant
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=3
# minimum seconds between model calls, to stay inside free-tier rate limits (0 = no limit)
LLM_MIN_INTERVAL_SECONDS=2.0

# --- storage (relative paths are resolved from the project root)
CHROMA_PATH=./storage/chroma
DECISION_DB_PATH=./storage/decisions.db
LLM_CACHE_PATH=./storage/llm_cache.db
EMBEDDING_MODEL_DIR=./models/all-MiniLM-L6-v2

# --- decision settings (routing thresholds live in config/routing_policy.json)
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.35
GROUNDING_MIN_SIM=0.40

# --- operations
AUTO_RESPOND_ENABLED=true
# set a long random value to enable POST /admin/kill-switch; leave empty to disable admin endpoints
ADMIN_TOKEN=
LOG_LEVEL=INFO
